<resources>
    <color name="portal_activity_background">#063366</color>
    <color name="portal_surface_bg">#063366</color>
    <color name="portal_loader_color">#E5D34A</color>
    <style name="PortalWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/portal_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/portal_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/portal_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/portal_fade_out</item>
    </style>

    <style name="Theme.TapCafeRush.Browser" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/portal_activity_background</item>
        <item name="android:statusBarColor">@color/portal_activity_background</item>
        <item name="android:navigationBarColor">@color/portal_activity_background</item>
        <item name="android:windowAnimationStyle">@style/PortalWindowAnimation</item>
        <item name="android:colorAccent">@color/portal_loader_color</item>
    </style>
</resources>
